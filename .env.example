NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/employee_management
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/employee_management
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_ACCESS_TTL=15m
JWT_ISSUER=employee-management-api
JWT_AUDIENCE=employee-management-client
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=10
